            "script": {
              "id": "cd02ff50-3369-45b3-ae4d-d880766b9e5f",
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Status code is \" + pm.variables.get(\"expected_status\"), () => {",
                "    pm.response.to.have.status(parseInt(pm.variables.get(\"expected_status\")));",
                "});",
                "",
                "pm.test(\"Content-Type is application/json\", () => {",
                "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                "});",
                "",
                "const tc = pm.variables.get(\"tc_id\");",
                "if (tc === \"GET_CAT_04\") {",
                "    pm.test(\"Schema matches categories list\", () => {",
                "        const jsonData = pm.response.json();",
                "        pm.expect(jsonData).to.be.an(\"array\");",
                "        if (jsonData.length > 0) {",
                "            pm.expect(jsonData[0]).to.have.any.keys(\"id\", \"name\", \"slug\");",
                "        }",
                "    });",
                "}",
                "if (tc === \"GET_CAT_05\") {",
                "    pm.test(\"Response time is less than 500ms\", () => {",
                "        pm.expect(pm.response.responseTime).to.be.below(500);",
                "    });",
                "}"
              ],
              "_lastExecutionId": "67a66262-722b-4e90-8d68-dd6b0f535b85"
            }
          }
