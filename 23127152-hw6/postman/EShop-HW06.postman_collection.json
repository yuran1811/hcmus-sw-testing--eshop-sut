    {
      "name": "API3 — FR-15 Product CRUD (Admin)",
      "description": "POST/PUT/DELETE /api/products — admin required per spec. Target ≥ 40 requests.",
      "item": [
        {
          "name": "Create product (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) pm.environment.set('productId', String(json.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"HW06 Test Product\",\n  \"price\": 100000,\n  \"description\": \"Created by HW06\",\n  \"imageUrl\": \"http://example.com/p.png\",\n  \"category_id\": 1\n}"
            },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Update product (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"HW06 Updated Product\",\n  \"price\": 120000,\n  \"description\": \"Updated by HW06\",\n  \"imageUrl\": \"http://example.com/p2.png\",\n  \"category_id\": 1\n}"
            },
