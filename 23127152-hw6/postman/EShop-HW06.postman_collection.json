            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-A1-001 status 200', () => pm.response.to.have.status(200));",
                  "pm.test('TC-A1-001 JSON array ≥1', () => { const j=pm.response.json(); pm.expect(j).to.be.an('array'); pm.expect(j.length).to.be.above(0); pm.environment.set('baselineCount', String(j.length)); });",
                  "pm.test('TC-A1-031 Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('TC-A1-033 required fields', () => { const p=pm.response.json()[0]; ['id','name','price','description','imageUrl','category_id'].forEach(k => pm.expect(p).to.have.property(k)); });",
                  "pm.test('TC-A1-034/035 types', () => { const p=pm.response.json()[0]; pm.expect(p.id).to.be.a('number'); pm.expect(p.name).to.be.a('string'); pm.expect(p.price).to.be.a('number'); });",
                  "pm.test('X-Student-Id was sent', () => { const h=pm.request.headers.get('X-Student-Id'); pm.expect(h).to.eql('23127152'); console.log('X-Student-Id=' + h); });"
                ]
