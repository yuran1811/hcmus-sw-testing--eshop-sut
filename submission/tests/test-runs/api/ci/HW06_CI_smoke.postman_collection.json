{
  "info": {
    "_postman_id": "23127115-hw06-ci-smoke",
    "name": "HW06 CI Smoke - 23127115",
    "description": "CI smoke contract for the three selected HW06 APIs. Full regression remains in the separate 145-case job.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "ciExpectedCreateStatus",
      "value": "200",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: '23127115' });",
          "console.log('[X-Student-Id] Header set = 23127115');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Setup - Login user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"test@eshop.com\",\"password\":\"Test1234!\"}"
        },
        "url": "{{baseUrl}}/api/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User login returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('ciUserToken', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Setup - Login admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@eshop.com\",\"password\":\"Admin123!\"}"
        },
        "url": "{{baseUrl}}/api/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('ciAdminToken', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "FR04 - Update profile responds",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{ciUserToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"CI User\",\"phone\":\"0912345678\",\"shipping_address\":\"CI Address\"}"
        },
        "url": "{{baseUrl}}/api/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('FR04 endpoint responds 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "FR09 - Apply valid coupon responds",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{ciUserToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"SAVE10\",\"total_amount\":500000,\"user_id\":2}"
        },
        "url": "{{baseUrl}}/api/apply-coupon"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('FR09 endpoint responds 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "FR17 - Create coupon contract",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{ciAdminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"CI{{$timestamp}}{{$randomInt}}\",\"type\":\"fixed\",\"discount_value\":10000,\"min_order_amount\":0,\"expired_at\":\"2099-12-31\",\"max_uses_per_user\":1}"
        },
        "url": "{{baseUrl}}/api/admin/coupons"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expected = Number(pm.collectionVariables.get('ciExpectedCreateStatus'));",
              "pm.test('FR17 create status matches CI contract', () => pm.response.to.have.status(expected));"
            ]
          }
        }
      ]
    }
  ]
}
