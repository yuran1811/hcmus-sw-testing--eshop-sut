    "name": "HW06 FR09 - POST /api/apply-coupon",
    "description": "Data-driven execution-ready collection for FR09_POST_api_apply_coupon. Includes isolated fixture setup, exact status/schema assertions, state verification and teardown.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
