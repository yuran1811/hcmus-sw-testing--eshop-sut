{
  "name": "postgresql-mini-lab-23127065",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible PostgreSQL database testing mini-lab",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:reset": "node scripts/run-sql.js schema.sql",
    "test": "jest --runInBand --verbose",
    "performance": "node scripts/run-sql.js schema.sql && node scripts/run-sql.js performance.sql",
    "verify:catalog": "node scripts/run-sql.js catalog-verification.sql",
    "evidence:transaction": "node scripts/run-sql.js schema.sql && node scripts/transaction-evidence.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "supertest": "^7.1.4"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/*.test.js"],
    "maxWorkers": 1
  }
}
