{
  "name": "eshop-fr06-playwright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "test:list": "playwright test --list",
    "test:chromium": "playwright test --project=chromium",
    "test:matrix": "node scripts/run-matrix.mjs",
    "finalize:reports": "node scripts/finalize-reports.mjs",
    "verify:reports": "node scripts/verify-report-visibility.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "@types/node": "24.1.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "volta": {
    "node": "22.23.1"
  }
}
